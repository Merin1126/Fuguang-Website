{
  "Directive Accent Container": {
    "prefix": "acc",
    "body": [
      ":::accent{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert accent container directive mapped to The Top Accent"
  },
  "Directive Glow Container": {
    "prefix": "glo",
    "body": [
      ":::glow{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert glow container directive mapped to The Glowing Edge"
  },
  "Directive Badge Container": {
    "prefix": "bad",
    "body": [
      ":::badge{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert badge container directive mapped to The Badge Floating"
  },
  "Directive Wire Container": {
    "prefix": "wir",
    "body": [
      ":::wire{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert wire container directive mapped to Minimal Wireframe"
  },
  "Directive Glass Container": {
    "prefix": "gla",
    "body": [
      ":::glass{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert glass container directive mapped to Frosted Glass"
  },
  "Directive Neon Container": {
    "prefix": "neo",
    "body": [
      ":::neon{title=\"$1\"}",
      "$2",
      ":::"
    ],
    "description": "Insert neon container directive mapped to Neon Warning Grid"
  },
  "Directive Keyword Inline": {
    "prefix": "kw",
    "body": [
      ":kw[$2]{variant=\"${1|cyber,amber,teal,violet,rose,lime|}\"}"
    ],
    "description": "Insert inline keyword directive mapped to KeywordChip"
  },
  "Profile 档案卡片": {
    "prefix": "pro",
    "body": [
      ":::profile{avatar=\"${1:logo.png}\"}",
      "### $2",
      "",
      "$3",
      ":::"
    ],
    "description": "插入带头像的左右排版档案卡片"
  },
  "Signature 署名样式": {
    "prefix": "sig",
    "body": [
      ":::sig",
      "${1:© 2026 撰写于东京 · 扶光}",
      ":::"
    ],
    "description": "插入扶光专属署名（容器 :::sig，套用 .fuguang-signature）"
  },
  "Dash Divider 虚线分隔符": {
    "prefix": "dash",
    "body": [
      ":::dash{mt=\"${1:16px}\" mb=\"${2:16px}\" opacity=\"${3:0.3}\"}",
      ":::"
    ],
    "description": "插入可复用的虚线分隔符（mdx 指令）"
  },
  "SideImage 图文混排": {
    "prefix": "side",
    "body": [
      ":::sideimg{src=\"${1:logo.png}\" pos=\"${2|left,right|}\" width=\"${3:300}\" alt=\"${4:图片说明}\"}",
      "$5",
      ":::"
    ],
    "description": "插入支持左右控制的图文排版块"
  }
}
