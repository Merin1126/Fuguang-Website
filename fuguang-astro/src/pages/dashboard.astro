---
import Navbar from '../components/Navbar.astro';
import BottomNav from '../components/BottomNav.astro';
import MainFooter from '../components/MainFooter.astro';
import ActionModal from '../components/ActionModal.astro';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>个人中心 - 扶光日语</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/dashboard.css"> <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-tab.svg">
</head>
<body>
    <Navbar />
    <ActionModal />
    
    <main class="home-main dash-main">
        <section class="dash-shell" aria-label="用户个人中心">
            <div class="dash-card">
                
                <header class="dash-hero">
                    <p class="dash-hero-subtitle">ADVENTURER PROFILE</p>
                    <h1>个人中心</h1>
                </header>

                <div class="dash-panel">
                    <div class="profile-header">
                        <div class="profile-avatar">
                            <i class="fa-solid fa-user-astronaut"></i>
                        </div>
                        <div class="profile-info">
                            <h2 id="user-nickname" class="skeleton-text">加载中...</h2>
                            <p id="user-email" class="skeleton-text">请稍候...</p>
                            <span id="user-level" class="level-badge">Lv.0 见习冒险者</span>
                        </div>
                    </div>

                    <hr class="dash-divider" />

                    <div class="dash-actions">
                        <button id="logout-btn" class="dash-logout-btn">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            退出登录
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <MainFooter />
    </main>

    <BottomNav />

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const token = localStorage.getItem('fuguang_token');

            // 1. 路由守卫：未登录时用 ActionModal 提示，再去登录页
            if (!token) {
                const goAuth = () => {
                    window.location.href = '/auth';
                };
                window.showActionModal?.('未登录', '您还未登录，请先登录！', '去登录', goAuth, {
                    variant: 'error',
                    onCancel: goAuth,
                });
                return;
            }

            // 2. 带着卡去 VIP 包厢获取信息
            try {
                const response = await fetch('http://127.0.0.1:8000/users/me', {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const user = await response.json();
                    
                    // 3. 把拿到信息渲染到页面上，移除加载状态
                    const nicknameEl = document.getElementById('user-nickname');
                    const emailEl = document.getElementById('user-email');
                    
                    if (nicknameEl) {
                        nicknameEl.textContent = user.nickname || user.username;
                        nicknameEl.classList.remove('skeleton-text');
                    }
                    if (emailEl) {
                        emailEl.textContent = user.email;
                        emailEl.classList.remove('skeleton-text');
                    }
                    
                    // 如果后端返回了 sponsor_level，也可以在这里更新 level-badge

                } else {
                    // 如果返回 401，说明卡过期了或伪造的
                    console.error("Token 无效或已过期");
                    localStorage.removeItem('fuguang_token');
                    window.location.href = '/auth';
                }
            } catch (error) {
                console.error("无法连接到服务器:", error);
            }

            // 4. 退出登录按钮逻辑
            const logoutBtn = document.getElementById('logout-btn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', () => {
                    window.showActionModal?.(
                        '退出登录',
                        '确定要退出当前账号吗？',
                        '确定退出',
                        () => {
                            localStorage.removeItem('fuguang_token');
                            window.location.href = '/auth';
                        },
                        { variant: 'confirm', cancelText: '取消' }
                    );
                });
            }
        });
    </script>
</body>
</html>