---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { mdxComponents } from '../../components/mdx-directive-components.mjs';
import ArticleToc from '../../components/ArticleToc.astro'; // 👈 1. 导入目录组件

export async function getStaticPaths() {
    const entries = await getCollection('grammar');
    return entries.map((entry) => ({
        params: { slug: entry.id.replace(/\.mdx?$/, '') },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const level = entry.data.level;
const grammarBreadcrumb: { label: string; href?: string }[] = [{ label: '语法文库', href: '/grammar' }];
if (level) {
    grammarBreadcrumb.push({
        label: `${level} 语法列表`,
        href: `/grammar/${level.toLowerCase()}`,
    });
}
---

<ArticleLayout {...entry.data} breadcrumbSegments={grammarBreadcrumb}>
    <ArticleToc headings={headings} />
    
    <Content components={mdxComponents} />
</ArticleLayout>
