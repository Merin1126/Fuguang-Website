---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
    return ['n1', 'n2', 'n3', 'n4', 'n5'].map((level) => ({
        params: { level },
    }));
}

const allPosts = await getCollection('grammar');
const levelParam = String(Astro.params.level ?? '').toLowerCase();
const currentLevel = levelParam.toUpperCase();

const posts = allPosts
    .filter((post) => post.data.level === currentLevel)
    .map((post) => ({
        ...post,
        slug: post.id.replace(/\.mdx?$/, ''),
    }));
---

<ArticleLayout title={`${currentLevel} 语法列表`} mainHeading={`${currentLevel} 语法列表`} tag="语法频道">
    <h2>{currentLevel} 级别文章</h2>
    {
        posts.length === 0 ? (
            <p>当前级别暂无文章。</p>
        ) : (
            <ul>
                {
                    posts.map((post) => (
                        <li>
                            <a href={`/grammar/${post.slug}`}>{post.data.title}</a>
                        </li>
                    ))
                }
            </ul>
        )
    }
</ArticleLayout>
