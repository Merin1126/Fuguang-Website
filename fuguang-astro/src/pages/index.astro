---
import { Image } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import BottomNav from '../components/BottomNav.astro';
import MainFooter from '../components/MainFooter.astro';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>扶光日语 - 次世代自学平台</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-tab.svg">
    <link rel="shortcut icon" href="/favicon-tab.svg">
</head>
<body>
    <Navbar />

    <main>
        <section class="home-main">
            <div class="hero-section">
                <h1>👇 见证终极复合魔法 👇</h1>
                <p>将鼠标悬停在下方卡片上测试扫光与变白特效...</p>
            </div>

            <div class="home-search-wrapper">
                <div class="home-search">
                    <div class="search-mode-toggle">
                        <div class="toggle-track">
                            <span class="toggle-label active">
                                <i class="fas fa-link"></i> 关联搜索
                            </span>
                            <span class="toggle-label">
                                <i class="fas fa-crosshairs"></i> 精准搜索
                            </span>
                            <div class="toggle-thumb"></div>
                        </div>
                    </div>

                    <div class="input-group">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" placeholder=" " class="search-input" autocomplete="off">
                        <span class="search-float-label">搜索单词、文章…</span>
                        <button class="search-clear"><i class="fas fa-times"></i></button>
                        <div class="search-dropdown">
                            <div class="dropdown-section">
                                <div class="dropdown-header">
                                    <span><i class="fas fa-history"></i> 搜索历史</span>
                                    <button class="clear-btn">清除全部</button>
                                </div>
                                <ul class="dropdown-list">
                                    <li>
                                        <a href="/search/history/desu">
                                            <span class="dropdown-item-main">
                                                <i class="fa-solid fa-comment-dots"></i>
                                                <span><span lang="ja">です</span>的用法</span>
                                            </span>
                                            <span class="dropdown-item-meta">历史</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/search/history/n3-grammar">
                                            <span class="dropdown-item-main">
                                                <i class="fa-solid fa-book-open"></i>
                                                <span>N3 文法</span>
                                            </span>
                                            <span class="dropdown-item-meta">历史</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="dropdown-section">
                                <div class="dropdown-header">
                                    <span><i class="fa-solid fa-wand-magic-sparkles"></i> 快捷入口</span>
                                </div>
                                <ul class="dropdown-list">
                                    <li>
                                        <a href="/grammar/n3">
                                            <span class="dropdown-item-main">
                                                <i class="fa-solid fa-book-open-reader"></i>
                                                <span>N3 语法列表</span>
                                            </span>
                                            <span class="dropdown-item-meta">Enter</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/exams/catti">
                                            <span class="dropdown-item-main">
                                                <i class="fa-solid fa-certificate"></i>
                                                <span>CATTI 考试入口</span>
                                            </span>
                                            <span class="dropdown-item-meta">Enter</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="fuguang-grid-container">
                <a href="/grammar/n5" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-seedling"></i></div>
                    <h2>入门</h2>
                </a>

                <a href="/vocabulary" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-language"></i></div>
                    <h2>单词</h2>
                </a>

                <a href="/grammar" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-book-open-reader"></i></div>
                    <h2>语法</h2>
                </a>

                <a href="/exams/catti" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-certificate"></i></div>
                    <h2>CATTI考试</h2>
                </a>

                <a href="/exams/kaoyan" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-user-graduate"></i></div>
                    <h2>考研日语</h2>
                </a>

                <a href="/exams/gaokao" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-school"></i></div>
                    <h2>高考日语</h2>
                </a>

                <a href="/exams/jlpt" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-file-circle-check"></i></div>
                    <h2>JLPT考试</h2>
                </a>

                <a href="/business" class="fuguang-card">
                    <div class="card-icon"><i class="fa-solid fa-briefcase"></i></div>
                    <h2>工作日语</h2>
                </a>
            </div>

            <div id="brandStoryContainer">
                <section class="home-brand-story">
                    <a href="/blog/about" class="home-brand-story__logo-link" title="关于扶光" aria-label="关于扶光"></a>
                    <h2 class="home-brand-story__title">欢迎来到扶光日语</h2>
                    <div class="home-brand-story__intro">
                        <div><span class="home-brand-story__founder-info">专为日语自学者设计的极简学习站</span></div>
                        <div><span class="home-brand-story__founder-info">解决自学痛点，告别繁杂的视觉干扰</span></div>
                        <div><span class="home-brand-story__founder-info">提供直击核心的语法与阅读训练</span></div>
                    </div>
                    <div class="home-brand-story__founder-signature">
                        <span class="home-brand-story__founder-role">主理人</span>
                        <a href="/blog/about" class="home-brand-story__founder-name">梅林</a>
                    </div>
                    <div class="home-brand-story__actions">
                        <div class="home-brand-story__social-section">
                            <div class="home-brand-story__social-divider"></div>
                            <div class="author-profile__social-links">
                                <a href="/social/wechat" class="author-profile__social-link" title="微信">
                                    <i class="fa-brands fa-weixin"></i>
                                </a>
                                <a href="/social/weibo" class="author-profile__social-link" title="微博">
                                    <i class="fa-brands fa-weibo"></i>
                                </a>
                                <a href="/social/bilibili" class="author-profile__social-link" title="bilibili">
                                    <i class="fa-brands fa-bilibili"></i>
                                </a>
                                <a href="/social/xiaohongshu" class="author-profile__social-link" title="小红书">
                                    <i class="fa-solid fa-book"></i>
                                </a>
                                <a href="/social/xianyu" class="author-profile__social-link" title="闲鱼">
                                    <i class="fa-solid fa-fish-fins"></i>
                                </a>
                            </div>
                            <div class="home-brand-story__social-divider"></div>
                        </div>
                    </div>
                </section>
            </div>
            <MainFooter />
        </section>
    </main>

    <div style="height: 1000px;"></div>

    <BottomNav />

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggle = document.querySelector<HTMLElement>('.search-mode-toggle');
            const thumb = document.querySelector<HTMLElement>('.toggle-thumb');
            const labels = document.querySelectorAll('.toggle-label');
            const input = document.querySelector<HTMLInputElement>('.search-input');
            const dropdown = document.querySelector<HTMLElement>('.search-dropdown');
            const clearBtn = document.querySelector<HTMLButtonElement>('.search-clear');

            toggle?.addEventListener('click', () => {
                if (!thumb) return;
                const isRight = thumb.style.transform === 'translateX(100%)';
                thumb.style.transform = isRight ? 'translateX(0)' : 'translateX(100%)';
                labels.forEach((label) => label.classList.toggle('active'));
            });

            input?.addEventListener('focus', () => {
                if (dropdown) dropdown.style.display = 'block';
            });

            input?.addEventListener('input', () => {
                if (clearBtn && input) {
                    clearBtn.style.display = input.value ? 'block' : 'none';
                }
            });

            clearBtn?.addEventListener('click', () => {
                if (!input || !clearBtn) return;
                input.value = '';
                clearBtn.style.display = 'none';
                input.focus();
            });

            document.addEventListener('click', (e) => {
                const target = e.target;
                if (!(target instanceof Element)) return;
                if (!target.closest('.home-search') && dropdown) {
                    dropdown.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>
