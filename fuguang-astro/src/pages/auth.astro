---
import Navbar from '../components/Navbar.astro';
import BottomNav from '../components/BottomNav.astro';
import MainFooter from '../components/MainFooter.astro';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登录 / 注册 - 扶光日语</title>
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-tab.svg">
</head>
<body>
    <Navbar />

    <main class="home-main auth-main">
        <section class="auth-shell" aria-label="用户认证">
            <div class="auth-card">
                <header class="auth-hero">
                    <p class="auth-hero-subtitle">Welcome to Fuguang</p>
                    <h1 id="auth-title">登录账号</h1>
                </header>

                <div class="auth-panel">
                    <div class="auth-social">
                        <button class="auth-social-btn" type="button" data-social-wechat>
                            <i class="fa-brands fa-weixin" aria-hidden="true"></i>
                            <span>使用微信登录</span>
                        </button>
                        <button class="auth-social-btn" type="button" data-social-qq>
                            <i class="fa-brands fa-qq" aria-hidden="true"></i>
                            <span>使用 QQ 登录</span>
                        </button>
                    </div>

                    <div class="auth-or">或</div>

                    <form class="auth-form" data-form="signup" novalidate>
                        <label class="auth-field">
                            <input type="email" name="registerEmail" autocomplete="email" placeholder=" " required />
                            <span>邮箱</span>
                        </label>

                        <label class="auth-field">
                            <input
                                type="text"
                                name="username"
                                autocomplete="username"
                                placeholder=" "
                                required
                                minlength="5"
                                maxlength="15"
                            />
                            <span>用户账号</span>
                        </label>
                        <p class="auth-hint">用户账号仅支持英文字母与数字，长度 5-15 个字符。</p>

                        <label class="auth-field">
                            <input type="password" name="password" autocomplete="new-password" placeholder=" " required />
                            <span>设置密码</span>
                        </label>

                        <label class="auth-field">
                            <input type="password" name="confirmPassword" autocomplete="new-password" placeholder=" " required />
                            <span>确认密码</span>
                        </label>

                        <label class="auth-field">
                            <input type="email" name="registerEmailConfirm" autocomplete="email" placeholder=" " required />
                            <span>确认邮箱</span>
                        </label>

                        <label class="auth-field">
                            <input
                                type="text"
                                name="nickname"
                                autocomplete="nickname"
                                placeholder=" "
                                required
                                minlength="5"
                                maxlength="15"
                            />
                            <span>您的昵称</span>
                        </label>
                        <p class="auth-hint">昵称仅支持中英日字符，长度 5-15 个字符。</p>

                        <button class="auth-submit" type="submit">创建账号</button>
                    </form>

                    <form class="auth-form is-active" data-form="signin" novalidate>
                        <label class="auth-field">
                            <input type="email" name="email" autocomplete="email" placeholder=" " required />
                            <span>邮箱</span>
                        </label>

                        <label class="auth-field">
                            <input type="password" name="password" autocomplete="current-password" placeholder=" " required />
                            <span>密码</span>
                        </label>

                        <button class="auth-submit" type="submit">登录</button>
                    </form>

                    <div class="auth-copy">
                        <p class="auth-copy-policy">
                            注册扶光账号即表示您同意<a href="/privacy" class="auth-inline-link">《隐私政策》</a>与<a href="/terms" class="auth-inline-link">《服务条款》</a>。
                        </p>
                        <p class="auth-copy-switch">
                            <span id="auth-switch-prefix">已有账号？</span>
                            <button type="button" class="auth-switch-link" id="auth-switch-link">注册账号</button>
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <MainFooter />
    </main>

    <BottomNav />

    <script>
        const titleEl = document.getElementById('auth-title');
        const signupForm = document.querySelector<HTMLFormElement>('.auth-form[data-form="signup"]');
        const signinForm = document.querySelector<HTMLFormElement>('.auth-form[data-form="signin"]');
        const switchBtn = document.getElementById('auth-switch-link') as HTMLButtonElement | null;
        const switchPrefix = document.getElementById('auth-switch-prefix');
        const socialWechat = document.querySelector<HTMLSpanElement>('[data-social-wechat] span');
        const socialQq = document.querySelector<HTMLSpanElement>('[data-social-qq] span');
        const signupUsernameInput = document.querySelector<HTMLInputElement>('input[name="username"]');
        const signupNicknameInput = document.querySelector<HTMLInputElement>('input[name="nickname"]');
        const signupPasswordInput = document.querySelector<HTMLInputElement>('input[name="password"]');
        const signupConfirmPasswordInput = document.querySelector<HTMLInputElement>('input[name="confirmPassword"]');
        const signupEmailInput = document.querySelector<HTMLInputElement>('input[name="registerEmail"]');
        const signupEmailConfirmInput = document.querySelector<HTMLInputElement>('input[name="registerEmailConfirm"]');

        let mode: 'signin' | 'signup' = 'signin';

        const nicknamePattern = /^(?=.{5,15}$)[A-Za-z\u3040-\u30FF\u3400-\u9FFF々ー]+$/;
        const usernamePattern = /^(?=.{5,15}$)[A-Za-z0-9]+$/;

        const syncUi = () => {
            const isSignup = mode === 'signup';
            signupForm?.classList.toggle('is-active', isSignup);
            signinForm?.classList.toggle('is-active', !isSignup);
            if (titleEl) titleEl.textContent = isSignup ? '创建账号' : '登录账号';
            if (socialWechat) socialWechat.textContent = isSignup ? '使用微信注册' : '使用微信登录';
            if (socialQq) socialQq.textContent = isSignup ? '使用 QQ 注册' : '使用 QQ 登录';
            if (switchPrefix) switchPrefix.textContent = isSignup ? '已有账号？' : '还没有账号？';
            if (switchBtn) switchBtn.textContent = isSignup ? '返回登录' : '注册账号';
        };

        switchBtn?.addEventListener('click', () => {
            mode = mode === 'signin' ? 'signup' : 'signin';
            syncUi();
        });

        signupUsernameInput?.addEventListener('input', () => {
            const value = signupUsernameInput.value.trim();
            if (!value) {
                signupUsernameInput.setCustomValidity('请输入用户账号。');
                return;
            }
            if (!usernamePattern.test(value)) {
                signupUsernameInput.setCustomValidity('用户账号仅限英数字，且长度需为 5-15 个字符。');
                return;
            }
            signupUsernameInput.setCustomValidity('');
        });

        signupNicknameInput?.addEventListener('input', () => {
            const value = signupNicknameInput.value.trim();
            if (!value) {
                signupNicknameInput.setCustomValidity('请输入昵称。');
                return;
            }
            if (!nicknamePattern.test(value)) {
                signupNicknameInput.setCustomValidity('昵称仅限中英日字符，且长度需为 5-15 个字符。');
                return;
            }
            signupNicknameInput.setCustomValidity('');
        });

        const validatePasswordMatch = () => {
            if (!signupPasswordInput || !signupConfirmPasswordInput) return;
            if (signupConfirmPasswordInput.value && signupPasswordInput.value !== signupConfirmPasswordInput.value) {
                signupConfirmPasswordInput.setCustomValidity('两次输入的密码不一致。');
                return;
            }
            signupConfirmPasswordInput.setCustomValidity('');
        };

        const validateEmailMatch = () => {
            if (!signupEmailInput || !signupEmailConfirmInput) return;
            if (signupEmailConfirmInput.value && signupEmailInput.value !== signupEmailConfirmInput.value) {
                signupEmailConfirmInput.setCustomValidity('两次输入的邮箱不一致。');
                return;
            }
            signupEmailConfirmInput.setCustomValidity('');
        };

        signupPasswordInput?.addEventListener('input', validatePasswordMatch);
        signupConfirmPasswordInput?.addEventListener('input', validatePasswordMatch);
        signupEmailInput?.addEventListener('input', validateEmailMatch);
        signupEmailConfirmInput?.addEventListener('input', validateEmailMatch);

        syncUi();
    </script>
</body>
</html>
