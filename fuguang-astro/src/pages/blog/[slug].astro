---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { mdxComponents as mdxBase } from '../../components/mdx-directive-components.mjs';
import { mdxArticleExtras } from '../../components/mdx-article-extras.mjs';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog');
    return blogEntries.map((entry) => ({
        params: { slug: entry.id.replace(/\.mdx?$/, '') },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const mdxComponents = { ...mdxBase, ...mdxArticleExtras };
---

<ArticleLayout
    title={entry.data.title}
    tag={entry.data.tag}
    date={entry.data.date}
    mainHeading={entry.data.mainHeading}
>
    <Content components={mdxComponents} />
</ArticleLayout>
