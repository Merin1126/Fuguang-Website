---
interface Props {
  title?: string;
}

const { title = 'The Glowing Edge' } = Astro.props as Props;
---

<section class="tge-callout">
  <div class="tge-title">{title}</div>
  <div class="tge-content">
    <slot />
  </div>
</section>

<style>
  .tge-callout {
    position: relative;
    margin: 22px 0;
    padding: 16px 18px;
    border-radius: 12px;
    background: linear-gradient(145deg, rgba(86, 42, 167, 0.28), rgba(26, 15, 50, 0.36));
    border: 1px solid rgba(158, 105, 255, 0.32);
    box-shadow: 0 10px 28px rgba(16, 6, 36, 0.36);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .tge-callout::before {
    content: "";
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 3px;
    border-radius: 0 999px 999px 0;
    background: linear-gradient(180deg, rgba(216, 165, 255, 0.95), rgba(130, 55, 255, 0.75));
    box-shadow: 0 0 14px rgba(166, 85, 255, 0.68), 0 0 24px rgba(127, 47, 255, 0.42);
  }

  .tge-title {
    margin-bottom: 8px;
    color: #e8d8ff;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tge-content {
    color: #efe6ff;
    text-shadow: 0 0 8px rgba(208, 166, 255, 0.2);
  }

  /* 🛡️ 隔离全局污染，重塑卡片内排版 */
  .tge-content :global(p) {
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 8px;
    text-align: justify;
    text-justify: inter-ideograph;
  }

  .tge-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .tge-callout:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: 0 0 0 1px rgba(171, 121, 255, 0.2), 0 16px 34px rgba(17, 6, 33, 0.48);
  }
</style>
