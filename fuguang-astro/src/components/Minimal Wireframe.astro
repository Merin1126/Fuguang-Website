---
interface Props {
  title?: string;
}

const { title = 'Minimal Wireframe' } = Astro.props as Props;
---

<section class="mw-callout">
  <div class="mw-title">{title}</div>
  <div class="mw-content">
    <slot />
  </div>
</section>

<style>
  .mw-callout {
    margin: 22px 0;
    padding: 14px 16px;
    border-radius: 10px;
    border: 1px dashed rgba(166, 177, 205, 0.4);
    background: rgba(19, 24, 34, 0.45);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .mw-title {
    margin-bottom: 8px;
    color: #bfcbe7;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mw-content {
    color: #d0d8ea;
    line-height: 1.8;
  }

  .mw-callout:hover {
    transform: translateY(-1px);
    border-color: rgba(189, 202, 236, 0.62);
    box-shadow: inset 0 0 0 1px rgba(176, 189, 224, 0.16), 0 10px 24px rgba(0, 0, 0, 0.3);
  }
</style>
