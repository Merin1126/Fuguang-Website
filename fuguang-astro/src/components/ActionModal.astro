---
// src/components/ActionModal.astro
---

<div id="fuguang-action-modal" class="modal-overlay" aria-hidden="true">
    <div class="modal-container">
        <div id="confetti-canvas"></div>

        <div class="modal-card">
            <button class="modal-close-btn" id="modal-close" aria-label="关闭">&times;</button>
            
            <div class="modal-banner">
                <div class="banner-icon">🎉</div>
            </div>

            <div class="modal-content">
                <h2 id="modal-title">操作成功</h2>
                <p id="modal-desc">您的账号已成功创建！现在您可以开始探索扶光日语的完整世界了。</p>
                
                <button class="modal-cta-btn" id="modal-cta">立即前往</button>
            </div>
        </div>
    </div>
</div>

<style is:global>
    /* 遮罩层：全屏、毛玻璃、深色背景 */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 15, 18, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        
        /* 隐藏状态 */
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    /* 展开状态 */
    .modal-overlay.is-open {
        opacity: 1;
        visibility: visible;
    }

    .modal-overlay.is-open .modal-card {
        transform: scale(1) translateY(0);
        opacity: 1;
    }

    /* 弹窗卡片本体 */
    .modal-card {
        position: relative;
        width: 90%;
        max-width: 420px;
        background: var(--bg-card, #2a2a2a);
        border-radius: 20px;
        overflow: hidden; /* 保证顶部的 banner 贴合圆角 */
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
        
        /* 进场动画初始状态 */
        transform: scale(0.95) translateY(20px);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        z-index: 2;
    }

    /* 顶部横幅 */
    .modal-banner {
        height: 140px;
        background: linear-gradient(135deg, rgba(163, 184, 214, 0.2), rgba(212, 184, 150, 0.15));
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .banner-icon {
        font-size: 64px;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* 关闭按钮 */
    .modal-close-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.3);
        color: #fff;
        border: none;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: background 0.2s ease;
    }

    .modal-close-btn:hover {
        background: rgba(0, 0, 0, 0.6);
    }

    /* 内容区 */
    .modal-content {
        padding: 32px;
        text-align: center;
    }

    .modal-content h2 {
        margin: 0 0 12px 0;
        font-size: 24px;
        color: var(--text-title, #fff);
    }

    .modal-content p {
        margin: 0 0 32px 0;
        font-size: 15px;
        color: var(--text-body, #a0a0a0);
        line-height: 1.6;
    }

    /* 底部按钮 */
    .modal-cta-btn {
        width: 100%;
        padding: 14px 24px;
        background: var(--text-title, #fff);
        color: #000;
        border: none;
        border-radius: 30px; /* 药丸形状 */
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .modal-cta-btn:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    /* =========================================
       🎉 纯原生 CSS 彩带物理系统
    ========================================= */
    #confetti-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
    }

    .confetti-piece {
        position: absolute;
        width: 10px;
        height: 20px;
        background: #ffd300;
        top: -20px;
        opacity: 0;
    }

    @keyframes makeItRain {
        0% { opacity: 1; transform: translateY(0) rotateZ(0deg) rotateX(0deg); }
        100% { opacity: 0; transform: translateY(100vh) rotateZ(360deg) rotateX(360deg); }
    }
</style>

<script is:inline>
    // 将方法挂载到 window 上，实现全局调用
    window.showActionModal = function(title, desc, btnText, onConfirm) {
        const modal = document.getElementById('fuguang-action-modal');
        const titleEl = document.getElementById('modal-title');
        const descEl = document.getElementById('modal-desc');
        const ctaBtn = document.getElementById('modal-cta');
        const closeBtn = document.getElementById('modal-close');
        const canvas = document.getElementById('confetti-canvas');

        // 设置文案
        titleEl.textContent = title;
        descEl.textContent = desc;
        ctaBtn.textContent = btnText;

        // 清除旧的事件监听，防止多次绑定
        ctaBtn.onclick = null;
        closeBtn.onclick = null;

        // 绑定新事件
        const closeModal = () => {
            modal.classList.remove('is-open');
            canvas.innerHTML = ''; // 清理彩带
        };

        closeBtn.onclick = closeModal;
        ctaBtn.onclick = () => {
            if(onConfirm) onConfirm();
            closeModal();
        };

        // 触发彩带特效
        fireConfetti(canvas);

        // 打开弹窗
        modal.classList.add('is-open');
    };

    // 物理彩带生成器
    function fireConfetti(canvas) {
        canvas.innerHTML = ''; // 清空之前的
        const colors = ['#A3B8D6', '#d4b896', '#ffffff', '#ffd300', '#ff6b6b'];
        
        for (let i = 0; i < 50; i++) {
            const piece = document.createElement('div');
            piece.className = 'confetti-piece';
            // 随机颜色
            piece.style.background = colors[Math.floor(Math.random() * colors.length)];
            // 随机水平位置
            piece.style.left = Math.random() * 100 + '%';
            // 随机下落延迟（制造层次感）
            piece.style.animationDelay = Math.random() * 2 + 's';
            // 随机下落速度
            piece.style.animationDuration = Math.random() * 2 + 3 + 's';
            // 随机大小
            piece.style.transform = `scale(${Math.random() * 0.8 + 0.5})`;
            
            piece.style.animationName = 'makeItRain';
            piece.style.animationTimingFunction = 'linear';
            piece.style.animationFillMode = 'forwards';

            canvas.appendChild(piece);
        }
    }
</script>