---
// src/components/ActionModal.astro
---

<div id="fuguang-action-modal" class="modal-overlay" aria-hidden="true">
    <div class="modal-container">
        <div class="modal-card">
            <canvas id="confetti-canvas" aria-hidden="true"></canvas>

            <button class="modal-close-btn" id="modal-close" aria-label="关闭">&times;</button>

            <div class="modal-banner" id="modal-banner">
                <div class="banner-icon" id="modal-banner-icon" aria-hidden="true">🎉</div>
            </div>

            <div class="modal-content">
                <h2 id="modal-title">操作成功</h2>
                <p id="modal-desc">您的账号已成功创建！现在您可以开始探索扶光日语的完整世界了。</p>

                <div class="modal-actions" id="modal-actions">
                    <button type="button" class="modal-cta-btn modal-cta-btn--secondary" id="modal-cancel" hidden>
                        取消
                    </button>
                    <button type="button" class="modal-cta-btn" id="modal-cta">立即前往</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style is:global>
    /* 遮罩层：全屏、毛玻璃、深色背景 */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        /* 略加深底色，替代全屏 backdrop-filter，避免与动画叠加时严重掉帧 */
        background: rgba(15, 15, 18, 0.88);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        
        /* 隐藏状态 */
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    /* 展开状态 */
    .modal-overlay.is-open {
        opacity: 1;
        visibility: visible;
    }

    .modal-overlay.is-open .modal-card {
        transform: scale(1) translateY(0);
        opacity: 1;
    }

    /*
     * 中间层必须给出明确宽度：否则在 flex 居中下会按 min-content 收缩，
     * 子元素 width: 90% 会相对「极窄的父级」计算，整卡会变成一条竖条。
     */
    .modal-container {
        position: relative;
        box-sizing: border-box;
        width: min(480px, calc(100vw - 2rem));
        flex-shrink: 0;
    }

    /* 弹窗卡片本体 */
    .modal-card {
        position: relative;
        width: 100%;
        background: var(--bg-card, #2a2a2a);
        border-radius: 20px;
        overflow: hidden; /* 圆角裁剪 + 彩带「笼子」 */
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
        
        /* 进场动画初始状态 */
        transform: scale(0.95) translateY(20px);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        z-index: 2;
    }

    /* 顶部横幅 */
    .modal-banner {
        height: 140px;
        background: linear-gradient(135deg, rgba(163, 184, 214, 0.2), rgba(212, 184, 150, 0.15));
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
        overflow: hidden;
    }

    /* 成功态：背景层大字（仅 is-success；错误 / 询问态不展示） */
    #fuguang-action-modal.is-success .modal-banner::before,
    #fuguang-action-modal.is-success .modal-banner::after {
        position: absolute;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: rgba(255, 255, 255, 0.11);
        white-space: nowrap;
        pointer-events: none;
        user-select: none;
        z-index: 0;
        line-height: 1.2;
    }

    #fuguang-action-modal.is-success .modal-banner::before {
        content: "欢迎进入";
        top: 30px;
        left: 30px;
        font-size: clamp(30px, 3.6vw, 40px);
    }

    #fuguang-action-modal.is-success .modal-banner::after {
        content: "扶光冒险者公会";
        right: 20px;
        bottom: 10px;
        font-size: clamp(30px, 3.4vw, 19px);
        text-align: right;
    }

    .banner-icon {
        position: relative;
        z-index: 1;
        font-size: 64px;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* 关闭按钮 */
    .modal-close-btn {
        position: absolute;
        top: 16px;
        right: 16px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.3);
        color: #fff;
        border: none;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: background 0.2s ease;
    }

    .modal-close-btn:hover {
        background: rgba(0, 0, 0, 0.6);
    }

    /* 内容区 */
    .modal-content {
        position: relative;
        z-index: 1;
        padding: 32px;
        text-align: center;
    }

    .modal-content h2 {
        margin: 0 0 12px 0;
        font-size: 24px;
        color: var(--text-title, #fff);
    }

    .modal-content p {
        margin: 0 0 32px 0;
        font-size: 15px;
        color: var(--text-body, #a0a0a0);
        line-height: 1.6;
    }

    /* 底部按钮 */
    .modal-cta-btn {
        width: 100%;
        padding: 14px 24px;
        background: var(--text-title, #fff);
        color: #000;
        border: none;
        border-radius: 30px; /* 药丸形状 */
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .modal-cta-btn:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    /* 错误态：仅横幅略偏暖色；图标与成功态共用 .banner-icon 的 float 动画 */
    #fuguang-action-modal.is-error .modal-banner {
        background: linear-gradient(135deg, rgba(200, 100, 100, 0.18), rgba(60, 30, 30, 0.22));
    }

    /* 询问态：❓、无彩带、无背景大字；横幅偏冷中性色 */
    #fuguang-action-modal.is-confirm .modal-banner {
        background: linear-gradient(135deg, rgba(130, 150, 190, 0.2), rgba(90, 100, 130, 0.14));
    }

    .modal-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
    }

    .modal-actions.modal-actions--dual {
        flex-direction: row;
        align-items: stretch;
    }

    .modal-actions.modal-actions--dual .modal-cta-btn {
        flex: 1;
    }

    .modal-cta-btn--secondary {
        background: transparent !important;
        color: rgba(255, 255, 255, 0.88) !important;
        border: 1px solid rgba(255, 255, 255, 0.28) !important;
    }

    .modal-cta-btn--secondary:hover {
        opacity: 0.95;
        border-color: rgba(255, 255, 255, 0.45) !important;
    }

    /* 单 canvas + rAF 绘制，避免大量 DOM/CSS 动画与毛玻璃抢 GPU */
    #fuguang-action-modal #confetti-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
        z-index: 5;
    }
</style>

<script is:inline>
    var __fuguangConfettiRaf = 0;

    function stopConfettiAnimation() {
        if (__fuguangConfettiRaf) {
            cancelAnimationFrame(__fuguangConfettiRaf);
            __fuguangConfettiRaf = 0;
        }
    }

    function clearConfettiCanvas(canvas) {
        if (!canvas || canvas.tagName !== 'CANVAS') return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    /**
     * 单 canvas + rAF：只有一块位图在动，避免几十个 div 的 CSS 动画与全屏模糊叠加卡顿。
     */
    function fireConfetti(canvas) {
        stopConfettiAnimation();
        clearConfettiCanvas(canvas);

        var colors = ['#A3B8D6', '#d4b896', '#ffffff', '#ffd300', '#ff6b6b'];
        var COUNT = 28;
        var ctx =
            canvas.getContext('2d', { alpha: true, desynchronized: true }) ||
            canvas.getContext('2d');
        if (!ctx) return;

        var rect = canvas.getBoundingClientRect();
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var bw = Math.max(1, Math.round(rect.width * dpr));
        var bh = Math.max(1, Math.round(rect.height * dpr));
        canvas.width = bw;
        canvas.height = bh;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        var cssW = rect.width;
        var cssH = rect.height;
        var particles = [];
        var i;
        for (i = 0; i < COUNT; i++) {
            particles.push({
                x: Math.random() * cssW,
                y: -24 - Math.random() * 72,
                w: 5 + Math.random() * 6,
                h: 8 + Math.random() * 10,
                vy: 1.4 + Math.random() * 2.2,
                vx: -0.5 + Math.random() * 1,
                rot: Math.random() * 6.28318,
                vr: -0.12 + Math.random() * 0.24,
                color: colors[(Math.random() * colors.length) | 0]
            });
        }

        var frame = 0;
        var maxFrames = 320;

        function tick() {
            frame++;
            rect = canvas.getBoundingClientRect();
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            bw = Math.max(1, Math.round(rect.width * dpr));
            bh = Math.max(1, Math.round(rect.height * dpr));
            if (canvas.width !== bw || canvas.height !== bh) {
                canvas.width = bw;
                canvas.height = bh;
            }
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            cssW = rect.width;
            cssH = rect.height;

            ctx.clearRect(0, 0, cssW + 2, cssH + 2);

            var alive = 0;
            var j;
            var p;
            var fade;
            for (j = 0; j < particles.length; j++) {
                p = particles[j];
                p.vy += 0.045;
                p.x += p.vx;
                p.y += p.vy;
                p.rot += p.vr;
                if (p.y < cssH + 48) {
                    alive++;
                    fade = Math.max(0, Math.min(1, 1 - (p.y - cssH * 0.25) / (cssH * 1.15)));
                    ctx.save();
                    ctx.globalAlpha = fade;
                    ctx.fillStyle = p.color;
                    ctx.translate(p.x, p.y);
                    ctx.rotate(p.rot);
                    ctx.fillRect(-p.w * 0.5, -p.h * 0.5, p.w, p.h);
                    ctx.restore();
                }
            }

            if (alive > 0 && frame < maxFrames) {
                __fuguangConfettiRaf = requestAnimationFrame(tick);
            } else {
                __fuguangConfettiRaf = 0;
            }
        }

        __fuguangConfettiRaf = requestAnimationFrame(tick);
    }

    /**
     * @param {{ variant?: 'success' | 'error' | 'confirm', cancelText?: string, onCancel?: () => void }} [options]
     * success：🎉+彩带；error：❌；confirm：❓+双按钮。
     * confirm 点取消/× 触发 onCancel；error/success 若提供 onCancel，点 × 也会触发（如未登录守卫统一跳转）。
     */
    window.showActionModal = function(title, desc, btnText, onConfirm, options) {
        var modal = document.getElementById('fuguang-action-modal');
        var titleEl = document.getElementById('modal-title');
        var descEl = document.getElementById('modal-desc');
        var ctaBtn = document.getElementById('modal-cta');
        var closeBtn = document.getElementById('modal-close');
        var cancelBtn = document.getElementById('modal-cancel');
        var actionsEl = document.getElementById('modal-actions');
        var canvas = document.getElementById('confetti-canvas');
        var bannerIcon = document.getElementById('modal-banner-icon');

        var variant = 'success';
        if (options && options.variant === 'error') variant = 'error';
        else if (options && options.variant === 'confirm') variant = 'confirm';

        modal.classList.remove('is-success', 'is-error', 'is-confirm');

        titleEl.textContent = title;
        descEl.textContent = desc;
        ctaBtn.textContent = btnText;

        if (bannerIcon) {
            if (variant === 'error') bannerIcon.textContent = '❌';
            else if (variant === 'confirm') bannerIcon.textContent = '❓';
            else bannerIcon.textContent = '🎉';
        }

        stopConfettiAnimation();
        clearConfettiCanvas(canvas);

        if (variant === 'error') {
            modal.classList.add('is-error');
            if (actionsEl) actionsEl.classList.remove('modal-actions--dual');
            if (cancelBtn) {
                cancelBtn.hidden = true;
                cancelBtn.onclick = null;
            }
        } else if (variant === 'confirm') {
            modal.classList.add('is-confirm');
            if (actionsEl) actionsEl.classList.add('modal-actions--dual');
            if (cancelBtn) {
                cancelBtn.hidden = false;
                cancelBtn.textContent = (options && options.cancelText) || '取消';
            }
        } else {
            modal.classList.add('is-success');
            if (actionsEl) actionsEl.classList.remove('modal-actions--dual');
            if (cancelBtn) {
                cancelBtn.hidden = true;
                cancelBtn.onclick = null;
            }
        }

        ctaBtn.onclick = null;
        closeBtn.onclick = null;

        var closeModal = function() {
            modal.classList.remove('is-open', 'is-error', 'is-success', 'is-confirm');
            if (actionsEl) actionsEl.classList.remove('modal-actions--dual');
            if (cancelBtn) {
                cancelBtn.hidden = true;
                cancelBtn.onclick = null;
            }
            stopConfettiAnimation();
            clearConfettiCanvas(canvas);
        };

        var dismissConfirm = function() {
            if (variant === 'confirm' && options && options.onCancel) options.onCancel();
            closeModal();
        };

        closeBtn.onclick = function() {
            if (variant === 'confirm') {
                dismissConfirm();
                return;
            }
            /* 错误/成功态下若提供 onCancel（如未登录守卫：点 × 也跳转） */
            if (options && typeof options.onCancel === 'function') {
                options.onCancel();
            }
            closeModal();
        };

        ctaBtn.onclick = function() {
            if (onConfirm) onConfirm();
            closeModal();
        };

        if (cancelBtn && variant === 'confirm') {
            cancelBtn.onclick = dismissConfirm;
        }

        modal.classList.add('is-open');
        if (variant === 'success' && canvas && canvas.tagName === 'CANVAS') {
            requestAnimationFrame(function() {
                requestAnimationFrame(function() {
                    fireConfetti(canvas);
                });
            });
        }
    };
</script>